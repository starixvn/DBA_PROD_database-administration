<DTS:Property DTS:Name="DisableEventHandlers">0</DTS:Property><DTS:ObjectData><SQLTask:SqlTaskData SQLTask:Connection="{1113D57F-211A-48B4-95CB-186701C6FEFA}" SQLTask:TimeOut="0" SQLTask:IsStoredProc="False" SQLTask:BypassPrepare="True" SQLTask:SqlStmtSourceType="DirectInput" SQLTask:SqlStatementSource="DECLARE @CustId INT;&#xA;&#xA;WHILE 0 = 0&#xA;BEGIN&#xA;    SELECT @CustId = NULL;&#xA;    UPDATE TOP(1) dbo.Credit_Supers&#xA;    SET @CustId = CustId&#xA;    , PTSportbook = 2&#xA;    WHERE PTSportbook = 0;&#xA;&#xA;    IF @CustId IS NULL BREAK;&#xA;&#xA;    EXECUTE dbo.DBA_CheckPT_Credit @srecommend = @CustId;&#xA;&#xA;    UPDATE Credit_Supers&#xA;    SET PTSportbook = 1&#xA;    WHERE CustId = @CustId&#xA;    AND PTSportbook = 2;&#xA;END;&#xA;&#xA;" SQLTask:CodePage="1252" SQLTask:ResultType="ResultSetType_None" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask"/></DTS:ObjectData></DTS:Executable>
