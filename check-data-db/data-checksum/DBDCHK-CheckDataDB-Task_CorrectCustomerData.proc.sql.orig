		;

	-- Debug Variables --
	DECLARE	@Msg			NVARCHAR(MAX)
		,	@Rowcount		INT
		;

	-- Temporary Tables --
	DECLARE	@Targets AS TABLE (
				TargetId		INT
			,	TargetServer	NVARCHAR(128)
			,	TargetDatabase	NVARCHAR(128)
			,	isSource		BIT
			,	TargetStatus	TINYINT
					DEFAULT (0)
			,	PRIMARY KEY CLUSTERED (TargetServer, TargetDatabase)
			);

	DECLARE	@TargetSchemas AS TABLE (
				TargetId		INT
			,	RowNum			INT
			,	ColName			NVARCHAR(128)
			,	ColType			NVARCHAR(256)
			,	PK				INT
			,	ID				BIT
			,	PRIMARY KEY CLUSTERED (TargetId, RowNum)
			);


	-- Check Checksum Task Status --
	IF	(SELECT TOP(1) isFinished FROM chksum.CheckHistory WITH (NOLOCK) ORDER BY ChkDate DESC) = 0
	BEGIN;
		IF	@IgnoreRunningChecksum = 0
		BEGIN;
			RAISERROR(N'\
[ERROR]		Task_CorrectCustomerData:
				Checksum is running.
				Aborting...', 0, 0) WITH NOWAIT;

			RETURN;
		END;
		ELSE
		BEGIN;
			RAISERROR(N'\
[VERBOSE]	Task_CorrectCustomerData:
				Checksum is running.
				@IgnoreRunningChecksum = TRUE
				Continuing...', 0, 0) WITH NOWAIT;
		END;
	END;

	-- Correcting based on last checking result --
	SELECT	TOP(1)
			@CheckTime = h.ChkDate
	FROM	chksum.CheckHistory AS h WITH (NOLOCK)
	WHERE	h.isFinished = 1
	ORDER BY ChkDate DESC;

	-- Loop for each result record --
	WHILE	0 = 0
	BEGIN;
