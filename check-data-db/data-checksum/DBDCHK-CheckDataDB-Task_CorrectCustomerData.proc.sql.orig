		-- Collect targets to work on --
		BEGIN;
			INSERT INTO	@Targets (TargetId, TargetServer, TargetDatabase, isSource, TargetStatus)
			SELECT	src.TargetId, src.TargetServer, src.TargetDatabase, 1, 0
			FROM		chksum.CheckResults AS r WITH (NOLOCK)
			INNER JOIN	chksum.Checklist AS l WITH (NOLOCK)
					ON	r.ItemId = l.ItemId
			INNER JOIN	chksum.TableConfigs AS tbl WITH (NOLOCK)
					ON	l.TableId = tbl.TableId
			INNER JOIN	chksum.Targets AS src WITH (NOLOCK)
					ON	l.SrcTarget = src.TargetId
			WHERE	tbl.SchName = @Schema
				AND	tbl.TblName = @Table
				AND	r.ChkDate = @CheckTime
				AND	r.IntervalFrom = @IntervalFrom
				AND	r.IntervalTo = @IntervalTo
			UNION
			SELECT	dst.TargetId, dst.TargetServer, dst.TargetDatabase, 0, 0
			FROM		chksum.CheckResults AS r WITH (NOLOCK)
			INNER JOIN	chksum.Checklist AS l WITH (NOLOCK)
					ON	r.ItemId = l.ItemId
			INNER JOIN	chksum.TableConfigs AS tbl WITH (NOLOCK)
					ON	l.TableId = tbl.TableId
			INNER JOIN	chksum.Targets AS dst WITH (NOLOCK)
					ON	l.TargetId = dst.TargetId
			WHERE	tbl.SchName = @Schema
				AND	tbl.TblName = @Table
				AND	r.ChkDate = @CheckTime
				AND	r.IntervalFrom = @IntervalFrom
				AND	r.IntervalTo = @IntervalTo;

			SELECT	@Rowcount = @@ROWCOUNT;
