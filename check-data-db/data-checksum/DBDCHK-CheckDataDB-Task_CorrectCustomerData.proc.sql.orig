		-- Drop adhoc tables --
		BEGIN;
			SELECT	@Query = N'';
			SELECT	@Query += tbls.str
			FROM	(
				SELECT	N'\
IF	OBJECT_ID(''adhoc.' + QUOTENAME(@Table + N'_' + t.TargetServer + N'_' + t.TargetDatabase + N'_' + CAST(CAST(@CheckTime AS INT) AS NVARCHAR)) + N''') IS NOT NULL
	DROP TABLE	adhoc.' + QUOTENAME(@Table + N'_' + t.TargetServer + N'_' + t.TargetDatabase + N'_' + CAST(CAST(@CheckTime AS INT) AS NVARCHAR)) + N';

		'
				FROM		@Targets AS t
				ORDER BY t.isSource DESC, t.TargetServer ASC, t.TargetDatabase ASC
				FOR XML PATH ('')
				,	TYPE
			) AS xtbl(xml)
			CROSS APPLY (
				SELECT	xtbl.xml.value('.[1]', 'NVARCHAR(MAX)')
			) AS tbls(str);

			EXECUTE	sys.sp_executesql @Query;

			IF	@Debug = 1
			BEGIN;
				RAISERROR('\
[VERBOSE]	Task_CorrectCustomerData:
				Adhoc tables are dropped.', 0, 0) WITH NOWAIT;
			END;
		END;


