	-- Table Variables --
	DECLARE	@Results AS TABLE (
				ItemId			INT
			,	IntervalFrom	BIGINT
			,	Result			VARCHAR(MAX)
			,	PRIMARY KEY CLUSTERED (ItemId, IntervalFrom)
			);


	-- Get last checked time --
	SELECT	TOP(1)
			@LastCheckTime = ChkDate
	FROM	chksum.CheckHistory AS h WITH (NOLOCK)
	WHERE	h.isFinished = 1
	ORDER BY h.ChkDate DESC;


	-- Get results --
	INSERT INTO	@Results (ItemId, IntervalFrom, Result)
	SELECT	[ItemId]		= i.ItemId
		,	[IntervalFrom]	= i.IntervalFrom
		,	[Result]		= rs.str
	FROM		(
		SELECT	DISTINCT _r.ItemId, _r.IntervalFrom
		FROM		chksum.CheckResults AS _r WITH (NOLOCK)
		INNER JOIN	chksum.CheckHistory AS _h WITH (NOLOCK)
				ON	_r.ChkDate = _h.ChkDate
		WHERE	_h.ChkDate <= @LastCheckTime
			AND	_h.isFinished = 1
	) AS i
	CROSS APPLY	(
		SELECT	CASE	WHEN _r.ChkDate IS NULL THEN '0'
						WHEN _r.SrcCount = _r.DstCount AND _r.SrcChecksum = _r.DstChecksum AND _r.SrcStdev = _r.DstStdev THEN '0'
						ELSE '1' END
		FROM		chksum.CheckHistory AS _h WITH (NOLOCK)
		LEFT JOIN	chksum.CheckResults AS _r WITH (NOLOCK)
				ON	_h.ChkDate = _r.ChkDate
				AND	i.ItemId = _r.ItemId
				AND	i.IntervalFrom = _r.IntervalFrom
		WHERE	_h.ChkDate <= @LastCheckTime
			AND	_h.isFinished = 1
