	SELECT	@Rowcount = @@ROWCOUNT;
	IF	@Debug = 1
	BEGIN;
		RAISERROR(N'\
[VERBOSE]	Task_ReportCustomerData
			Collected %d items to report.', 0, 0, @Rowcount) WITH NOWAIT;
	END;

	-- Clear OK items --
	DELETE	r
	FROM		chksum.CheckResults AS r WITH (ROWLOCK)
	INNER JOIN	chksum.CheckHistory AS h WITH (NOLOCK)
			ON	r.ChkDate = h.ChkDate
	INNER JOIN	@Results AS tmp
			ON	r.ItemId = tmp.ItemId
			AND	r.IntervalFrom = tmp.IntervalFrom
	WHERE	h.ChkDate <= @LastCheckTime
		AND	h.isFinished = 1
		AND	tmp.Result LIKE REPLICATE('0', @Clear) + '%';

