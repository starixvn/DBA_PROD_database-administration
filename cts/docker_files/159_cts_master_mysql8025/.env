#network
MYSQL_NETWORK=cts_network
EXTERNAL_NETWORK=true
DRIVER_NETWORK=bridge

#mysql container
MYSQL_TAG=8.0.25
MYSQL_HOST=cts_master_mysql80
MYSQL_PORT=3306
MYSQL_DATA=/data01/cts_master_mysql80/data
MYSQL_CONF=/data01/cts_master_mysql80/config
MYSQL_LOG=/data01/cts_master_mysql80/log
MYSQL_TMP=/data01/cts_master_mysql80/tmp
MYSQL_BINLOG=/data01/cts_master_mysql80/binlog
MYSQL_DATA2=/data02/cts_master_mysql80/data

#volume
DATA_VOLUME=cts_master_mysql80_data
EXTERNAL_VOLUME=true

#use host
UID=40159
GID=40159
