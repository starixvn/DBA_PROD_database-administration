[client]
default-character-set       = utf8

[mysql]
default-character-set       = utf8

[mysqld]
user=mysql
character-set-server        = utf8
collation-server            = utf8_unicode_ci
secure-file-priv            = /var/log/mysql/tmp

key_buffer_size             = 16M
max_allowed_packet          = 131989504
thread_cache_size           = 24
max_connections             = 2000

#I/O threads
innodb_read_io_threads = 32
innodb_write_io_threads = 32

#recommendation
innodb_file_per_table=ON
innodb_stats_on_metadata = OFF


#buffer pool size
innodb_buffer_pool_chunk_size=3G
innodb_buffer_pool_instances=64
innodb_buffer_pool_size=192G


innodb_log_file_size = 512M
innodb_flush_log_at_trx_commit = 1 # may change to 2 or 0
innodb_flush_method = O_DIRECT
innodb_buffer_pool_dump_pct = 100
tmp_table_size=67108864 #64M
innodb_read_ahead_threshold=32 
innodb_random_read_ahead=ON

innodb_old_blocks_pct=10
innodb_io_capacity=500
#tmp
tmpdir = /var/log/mysql/tmp

#biglog
log_bin = /var/log/mysql/binlog/binlog.log
relay_log = /var/log/mysql/binlog/replay-bin.log
#expire_logs_days  = 3
binlog_expire_logs_seconds=259200
max_binlog_size   = 300M

#mysql logs
#TABLE|FILE
log_output = TABLE

#startup log
general_log = 0
general_log_file = /var/log/mysql/general.log

#error log
log_error=/var/log/mysql/error.log
#1: ERROR
#2: ERROR, WARNING
#3: ERROR, WARNING, INFORMATION
log_error_verbosity = 1


#slow logs
slow_query_log = 1
slow_query_log_file = /var/log/mysql/slow_query.log
long_query_time = 60 #10s


# --------------------------
# Transaction Isolation Level Configuration
# --------------------------
transaction_isolation       = "READ-COMMITTED"

# --------------------------
# Extend Group Concat limitation
# --------------------------
group_concat_max_len        = 1048576

# --------------------------
# Security Configuration
# --------------------------
activate_all_roles_on_login = 1

#replication
default_authentication_plugin=mysql_native_password
server_id = 40159
gtid_mode=ON
enforce_gtid_consistency=ON

#binlog dbs
#binlog_do_db   = db

#replicated db
#replicate_do_db = xxxxx


#ROW|STATEMENT|MIXED
binlog_format=ROW
log_slow_slave_statements=1


#SLAVE mode
#read_only = true
#super_read_only = true

#event_scheduler=OFF
