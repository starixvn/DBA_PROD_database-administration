#network
MYSQL_NETWORK=cts_network
EXTERNAL_NETWORK=false
DRIVER_NETWORK=bridge

#mysql container
MYSQL_TAG=8.0.25
MYSQL_HOST=cts_master_mysql80
MYSQL_PORT=3361
MYSQL_DATA=/mount/cts/cts_master_mysql80/data
MYSQL_CONF=/mount/cts/cts_master_mysql80/config
MYSQL_LOG=/mount/cts/cts_master_mysql80/log
MYSQL_TMP=/mount/cts/cts_master_mysql80/tmp
MYSQL_BINLOG=/mount/cts/cts_master_mysql80/binlog
MYSQL_VOLUME_PATH=/mount/cts/cts_master_mysql80/vol_data

#volume
DATA_VOLUME=cts_master_mysql80_data
EXTERNAL_VOLUME=false

#use host
UID=40159
GID=40159
