#network
MSSQL_NETWORK=mssql_network_fps_db02
EXTERNAL_NETWORK=true
DRIVER_NETWORK=bridge

#config
MSSQL_DATA=/mount/fps/user_data/fps_db02
MSSQL_LOG=/mount/fps/user_data/fps_db02
MSSQL_CONF=/mount/fps/user_data/fps_db02/conf.d

#docker second env file
MSSQL_CONFIG_DIR=/mount/fps/yaml_config_files/fps_db02

#ls folder
LOGSHIPPNG_DIR=/mount/fps/logshipping

#backup folder
BACKUP_DIR=/mount/fps/backup

#tls config
TLS_DIR=/mount/fps/tls_config/fps_db02/

#container
MSSQL_TAG=2019-latest
MSSQL_HOST=fps_db02
MSSQL_PORT=16402
