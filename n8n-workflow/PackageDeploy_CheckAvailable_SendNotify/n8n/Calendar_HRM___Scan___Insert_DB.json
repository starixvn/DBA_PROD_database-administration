    {
      "parameters": {
        "functionCode": "let cookies;\n\nif ($json.headers && $json.headers['set-cookie']) {\n  const rawCookies = $json.headers['set-cookie'];\n  cookies = rawCookies.map(cookieStr => cookieStr.split(';')[0]).join('; ');\n} else {\n  cookies = $node[\"Extract Token & Cookies\"].json[\"cookies\"];\n}\n\nreturn [{ json: { cookies } }];"
      },
      "id": "3b27858c-4a2e-4e82-bd8c-ca4a338753a7",
      "name": "Get Final Cookie HRM",
