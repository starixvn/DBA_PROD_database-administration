    {
      "parameters": {
        "jsCode": "const loginName = 'evan.trinh';\nconst siteName = 'HRM';\n\nconst today = new Date(); // mặc định là UTC\nconst dayOfWeek = today.getUTCDay(); // 0 = Chủ nhật, 1 = Thứ 2, ..., 6 = Thứ 7\n\n// Tính ngày thứ 2 (Monday)\nconst monday = new Date(today);\nmonday.setUTCDate(today.getUTCDate() - ((dayOfWeek + 6) % 7));\n\n// Tính ngày thứ 6 (Friday)\nconst friday = new Date(monday);\nfriday.setUTCDate(monday.getUTCDate() + 4);\n\n// Format thành chuỗi dạng 25Jul2025\nfunction formatDate(date) {\n  return date.getUTCDate().toString().padStart(2, '0') +\n    date.toLocaleString('en-US', { month: 'short', timeZone: 'UTC' }) +\n    date.getUTCFullYear();\n}\n\nconst fromDate = formatDate(monday);\nconst toDate = formatDate(friday);\nconst toDay = formatDate(today);  // thêm dòng này\n\n// Lấy thời gian hiện tại (UTC+7)\nconst now = new Date();\nconst offsetMs = 7 * 60 * 60 * 1000; // +07:00\nconst vietnamTime = new Date(now.getTime() + offsetMs);\n\n// Format thành \"YYYY-MM-DD HH:mm:ss\"\nfunction formatDateTime(date) {\n  return date.toISOString().replace('T', ' ').substring(0, 19);\n}\n\nreturn $input.all().map(item => {\n  return {\n    json: {\n      ...item.json,\n      LoginName: loginName,\n      SiteName: siteName,\n      FromDate: fromDate,\n      ToDate: toDate,\n      ToDay: toDay,  // thêm dòng này\n      startTime: formatDateTime(vietnamTime)\n    }\n  };\n});\n"
      },
