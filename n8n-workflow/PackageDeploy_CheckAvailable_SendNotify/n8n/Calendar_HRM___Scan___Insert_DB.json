    {
      "parameters": {
        "jsCode": "// List of official team member emails\nconst teamEmails = [\n  \"kean.nguyen@starixsoft.com\",\n  \"malcolm.huynh@starixsoft.com\",\n  \"lukas.luu@starixsoft.com\",\n  \"roy.du@starixsoft.com\",\n  \"dominic.dao@starixsoft.com\",\n  \"daniel.truong@starixsoft.com\",\n  \"patrick.pham@starixsoft.com\",\n  \"sol.le@starixsoft.com\",\n  \"evan.trinh@starixsoft.com\",\n  \"brice.nguyen@starixsoft.com\"\n];\n\nfunction toLocalSqlDatetime(isoString) {\n  return isoString.replace('T', ' ').slice(0, 19); \n}\n\n\n\nconst output = [];\n\nfor (const item of items) {\n  const event = item.json;\n\n  // Skip if event has no start time\n  if (!event.start?.dateTime) continue;\n\n  // Filter attendees that are in our team\n  const matched = (event.attendees || [])\n    .filter(att => teamEmails.includes(att.email))\n    .map(att => att.email.replace('@starixsoft.com', '')); // Remove domain\n\n  if (matched.length === 0) continue;\n\n\n  const rawRuntime = $('SetTime').first().json.runtime;\n  const cleanRuntime = rawRuntime.split('.')[0];  \n  \n  // Build SQL-friendly record\n  output.push({\n    json: {\n      id:event.id,\n      start: toLocalSqlDatetime(event.start.dateTime),\n      end: event.end?.dateTime ? toLocalSqlDatetime(event.end.dateTime) : null,\n      attendees: matched.join(','),\n      room: event.organizer?.displayName || null,\n      summary: event.summary || null,\n      runtime : cleanRuntime\n    }\n  });\n}\n\nreturn output;\n"
      },
