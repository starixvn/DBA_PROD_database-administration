    {
      "parameters": {
        "jsCode": "// Get current UTC time and convert to Vietnam time (UTC+7)\nconst nowUTC = new Date();\nconst nowVN = new Date(nowUTC.getTime() + 7 * 60 * 60 * 1000);  // shift +7h\n\n// Clone and reset time to Monday 00:00\nconst nowVN1 = new Date(nowVN);\nconst day = nowVN1.getDay(); // Sunday = 0, Monday = 1, ..., Saturday = 6\nconst diff = (day === 0 ? -6 : 1 - day); // Adjust for Sunday being 0\nnowVN1.setDate(nowVN1.getDate() + diff);\nnowVN1.setHours(0, 0, 0, 0);\nnowVN.setTime(nowVN1); // Set nowVN to start of this Monday\n\n// Format timeMin as Monday 00:00 in Vietnam time, ISO format\nconst yyyyNow = nowVN.getFullYear();\nconst mmNow = String(nowVN.getMonth() + 1).padStart(2, '0');\nconst ddNow = String(nowVN.getDate()).padStart(2, '0');\nconst hhNow = String(nowVN.getHours()).padStart(2, '0');\nconst minNow = String(nowVN.getMinutes()).padStart(2, '0');\nconst timeMin = `${yyyyNow}-${mmNow}-${ddNow}T${hhNow}:${minNow}:00+07:00`;\n\n// Calculate day of week (0 = Sunday, ..., 6 = Saturday)\nconst currentDay = nowVN.getDay();\nconst diffToMonday = currentDay === 0 ? 6 : currentDay - 1;\n\n// Get Monday of this week\nconst monday = new Date(nowVN);\nmonday.setDate(nowVN.getDate() - diffToMonday);\n\n// Get Friday of this week\nconst friday = new Date(monday);\nfriday.setDate(monday.getDate() + 4);\n\n// Format timeMax as Friday 18:00 in Vietnam time\nconst yyyy = friday.getFullYear();\nconst mm = String(friday.getMonth() + 1).padStart(2, '0');\nconst dd = String(friday.getDate()).padStart(2, '0');\nconst timeMax = `${yyyy}-${mm}-${dd}T18:00:00+07:00`;\n\n// Add runtime (current moment) in ISO string with +07:00\nconst nowVNRuntime = new Date(nowUTC.getTime() + 7 * 60 * 60 * 1000);\nconst runtime = nowVNRuntime.toISOString().replace('Z', '+07:00');\n\nreturn [{\n  json: {\n    timeMin,\n    timeMax,\n    runtime\n  }\n}];\n"
      },
