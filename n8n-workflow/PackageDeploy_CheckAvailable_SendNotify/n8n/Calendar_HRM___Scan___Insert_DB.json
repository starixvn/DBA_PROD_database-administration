    {
      "parameters": {
        "jsCode": "const htmlData = $input.first().json.data;\n\n// Tìm tất cả các dòng <tr class=\"noshift\">\nconst rowMatches = [...htmlData.matchAll(/<tr[^>]*class=['\"]noshift['\"][^>]*>[\\s\\S]*?<\\/tr>/gi)];\n\nfunction decodeHtmlEntities(str) {\n  return str\n    .replace(/&#x([0-9A-Fa-f]+);/g, (_, hex) => String.fromCharCode(parseInt(hex, 16)))\n    .replace(/&amp;/g, '&')\n    .replace(/&lt;/g, '<')\n    .replace(/&gt;/g, '>')\n    .replace(/&quot;/g, '\"')\n    .replace(/&#39;/g, \"'\");\n}\n\n// Format \"06 Aug, 2025\" → \"2025-08-06\"\nfunction formatDateString(dateStr) {\n  const parsedDate = new Date(dateStr.replace(',', ''));\n  const year = parsedDate.getFullYear();\n  const month = String(parsedDate.getMonth() + 1).padStart(2, '0'); // zero-based\n  const day = String(parsedDate.getDate()).padStart(2, '0');\n  return `${year}-${month}-${day}`;\n}\n\nconst results = [];\n\nfor (const rowMatch of rowMatches) {\n  const row = rowMatch[0];\n\n  // Tìm tất cả các <td> trong dòng\n  const cells = [...row.matchAll(/<td[^>]*>([\\s\\S]*?)<\\/td>/gi)].map(cell =>\n    decodeHtmlEntities(cell[1].replace(/\\n/g, '').trim())\n  );\n\n  // Bỏ qua dòng không đủ dữ liệu\n  if (cells.length < 11) continue;\n\n  const employee = cells[3];\n  const checkIn = cells[8] || null;\n  const checkOut = cells[9] || null;\n\n  const rawDate = cells[1];\n  const date = formatDateString(rawDate);\n\n  results.push({\n    employee,\n    date,\n    checkIn,\n    checkOut,\n  });\n}\n\nreturn results;\n"
      },
