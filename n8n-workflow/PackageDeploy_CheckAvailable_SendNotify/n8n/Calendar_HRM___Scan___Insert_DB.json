    {
      "parameters": {
        "jsCode": "const monthMap = {\n  Jan: 0, Feb: 1, Mar: 2, Apr: 3, May: 4, Jun: 5,\n  Jul: 6, Aug: 7, Sep: 8, Oct: 9, Nov: 10, Dec: 11\n};\n\nconst output = [];\nconst data = $input.all().map(item => item.json);\n\nconst parseDate = (str, fallbackYear = null, fallbackMonth = null) => {\n  const cleaned = str.trim().replace(',', '');\n  const parts = cleaned.split(' ');\n  const day = parseInt(parts[0], 10);\n  const month = monthMap[parts[1]] ?? fallbackMonth;\n  const year = parseInt(parts[2], 10) || fallbackYear;\n  return new Date(year, month, day);\n};\n\nfor (const item of data) {\n  const { employee, fullname, team, leaveDate } = item;\n\n  // Parse time if exists\n  const timeMatch = leaveDate.match(/\\((\\d{2}:\\d{2})-(\\d{2}:\\d{2})\\)/);\n  let fromTime = timeMatch?.[1] || \"08:00\";\n  let toTime = timeMatch?.[2] || \"18:00\";\n\n  // Remove time from leaveDate\n  const dateClean = leaveDate.replace(/\\s*\\(.*?\\)/, '').trim();\n  const isRange = dateClean.includes(' - ');\n\n  if (isRange) {\n    const [fromStrRaw, toStrRaw] = dateClean.split(' - ');\n\n    const toParts = toStrRaw.trim().replace(',', '').split(' '); // e.g., [\"29\", \"Jul\", \"2025\"]\n    const dayFrom = parseInt(fromStrRaw.trim(), 10);\n    const month = monthMap[toParts[1]];\n    const year = parseInt(toParts[2], 10);\n\n    const start = new Date(year, month, dayFrom);\n    const end = parseDate(toStrRaw);\n\n    for (let d = new Date(start); d <= end; d.setDate(d.getDate() + 1)) {\n      output.push({\n        employee,\n        fullname,\n        team,\n        date: d.toISOString().slice(0, 10),\n        fromTime,\n        toTime\n      });\n    }\n\n  } else {\n    const singleDate = parseDate(dateClean);\n    output.push({\n      employee,\n      fullname,\n      team,\n      date: singleDate.toISOString().slice(0, 10),\n      fromTime,\n      toTime\n    });\n  }\n}\n\nreturn output;\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        8400,
        -7460
      ],
      "id": "08c3ad62-cac3-497c-9a5e-7079b72a1395",
      "name": "Parse Leave Dates",
      "executeOnce": true
    },
    {
      "parameters": {
        "jsCode": "const htmlData = $input.first().json.data;\n\n// Match tất cả dòng <tr>\nconst rowMatches = [...htmlData.matchAll(/<tr[^>]*>[\\s\\S]*?<\\/tr>/gi)];\n\nfunction decodeHtmlEntities(str) {\n  return str.replace(/&#x([0-9A-Fa-f]+);/g, (_, hex) =>\n    String.fromCharCode(parseInt(hex, 16))\n  );\n}\n\nconst results = [];\n\nfor (const rowMatch of rowMatches) {\n  const row = rowMatch[0];\n\n  const tdTooltips = [...row.matchAll(/<td[^>]*class=['\"]tooltip['\"][^>]*title=['\"]([^'\"]+)['\"][^>]*>([\\s\\S]*?)<\\/td>/gi)];\n\n  const teamTitle = tdTooltips[0]?.[1]?.trim() || '';\n  if (teamTitle !== 'Pontus') continue;\n\n  const employeeName = tdTooltips[1]?.[2]?.trim() || 'Unknown';\n  const employeeFullnameRaw = tdTooltips[1]?.[1]?.trim() || '';\n  const employeeFullname = decodeHtmlEntities(employeeFullnameRaw);\n\n  const leaveMatches = [...row.matchAll(/<span[^>]*class=['\"][^'\"]*\\bleave\\b[^'\"]*['\"][^>]*>([\\s\\S]*?)<\\/span>/gi)];\n  const leaveDate = leaveMatches[0]?.[1]?.trim() || null;\n\n  if (!leaveDate) {\n    console.warn(`[Node: \"Code2\"] ⚠️ Không tìm thấy <span class=\"req leave\"> trong dòng của ${employeeName}`);\n    continue;\n  }\n\n  results.push({\n    employee: employeeName,\n    fullname: employeeFullname,\n    team: teamTitle,\n    leaveDate: leaveDate\n  });\n}\n\nreturn results;\n"
      },
