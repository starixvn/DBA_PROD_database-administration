      "parameters": {
        "functionCode": "// Lấy HTML từ response\nconst html = $json.body || $json.data;\n\n// Lấy token bằng regex\nconst match = html.match(/<input[^>]+name=\"__RequestVerificationToken\"[^>]+value=\"([^\"]+)\"/);\n\n// Lấy cookie từ header\nconst setCookie = $json.headers['set-cookie'];\nconst cookies = Array.isArray(setCookie)\n  ? setCookie.map(c => c.split(';')[0]).join('; ')\n  : '';\n\nif (!match || !match[1]) {\n  throw new Error(\"Không tìm thấy token!\");\n}\n\nreturn [\n  {\n    json: {\n      token: match[1],\n      cookies,\n    }\n  }\n];\n"
      },
