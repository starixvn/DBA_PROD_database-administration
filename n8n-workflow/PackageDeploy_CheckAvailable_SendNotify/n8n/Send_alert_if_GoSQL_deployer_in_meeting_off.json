    {
      "parameters": {
        "jsCode": "return $input.all().map(item => {\n    const json = item.json;\n    const assignee = json.Assignee || 'Unknown';\n    const requester = json.Requester || 'someone';\n    const baseMessage = json.Message || '';\n    const reason = json.Reason || 'Unavailable';\n    let notification = '';\n\n    // Format deploy message as blockquote\n    const formattedBaseMessage = baseMessage ? `> ${baseMessage.trim().replace(/\\n/g, '\\n> ')}` : '';\n\n    const deployTime = new Date(json.DeployIn);\n    const today = new Date();\n    const isToday = deployTime.toDateString() === today.toDateString();\n    const whenText = isToday ? 'today' : 'at the scheduled time';\n\n    // Start with a greeting\n    notification += `⚠️ *PACKAGE DEPLOY ALERT* 🚀 \\n\\n Hi *${requester}*,\\n\\n`;\n\n    if (reason === 'In a meeting') {\n        const room = json.Room || 'unknown room';\n        const start = new Date(json.StartTime);\n        const end = new Date(json.EndTime);\n        const startStr = start.toLocaleTimeString('en-GB', { hour: '2-digit', minute: '2-digit' });\n        const endStr = end.toLocaleTimeString('en-GB', { hour: '2-digit', minute: '2-digit' });\n        notification += `📅 *${assignee}* is in a meeting (${startStr}–${endStr}) ${whenText}, 🚫 can't deploy.\\n:point_right: Contact Pontus team for reassignment.`;\n    } \n    else if (reason === 'Checkin/checkout') {\n        const checkIn = json.CheckInTime;\n        const checkOut = json.CheckOutTime || '17:00';\n        \n        // Check if CheckInTime is null or 'null'\n        if (checkIn === null || checkIn === 'null' || !checkIn) {\n            notification += `🏠 *${assignee}* hasn't checked in yet, 🚫 can't deploy ${whenText}.\\n:point_right: Contact Pontus team for reassignment.`;\n        } else {\n            notification += `🕐 *${assignee}* working hours (${checkIn}–${checkOut}), 🚫 can't deploy ${whenText}.\\n:point_right: Contact Pontus team for reassignment.`;\n        }\n    }\n    else if (json.Leavedate) {\n        const leaveDateObj = new Date(json.Leavedate);\n        const leaveDateStr = leaveDateObj.toLocaleDateString('en-GB');\n        const from = json.FromTime || '08:00';\n        const to = json.ToTime || '18:00';\n        const timeNote = (from === '08:00' && to === '18:00') ? '' : `(${from}–${to})`;\n        notification += `🌴 *${assignee}* is on leave *${leaveDateStr}*${timeNote}, 🚫 can't deploy ${whenText}.\\n :point_right: Contact Pontus team for reassignment.`;\n    } \n    else {\n        notification += `🚫 *${assignee}* isn't available ${whenText}.\\n:point_right: Contact Pontus team for reassignment.`;\n    }\n\n    // Add deploy info blockquote\n    if (formattedBaseMessage) {\n        notification += `\\n\\n${formattedBaseMessage}`;\n    }\n\n    // Footer\n    notification += `\\n\\n➵➵➵➵➵➵➵➵➵➵➵➵`;\n\n    return {\n        json: {\n            message: notification,\n            DeployID: json.DeployID,\n            Requester: json.Requester\n        }\n    };\n});"
      },
