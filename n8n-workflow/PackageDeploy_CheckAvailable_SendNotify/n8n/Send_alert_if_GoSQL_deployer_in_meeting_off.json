      "parameters": {
        "functionCode": "const cookies = $json.headers['set-cookie']\n  ? $json.headers['set-cookie'].map(c => c.split(';')[0]).join('; ')\n  : $node[\"Extract Token & Cookies\"].json[\"cookies\"];\n\nreturn [{ json: { cookies } }];"
      },
