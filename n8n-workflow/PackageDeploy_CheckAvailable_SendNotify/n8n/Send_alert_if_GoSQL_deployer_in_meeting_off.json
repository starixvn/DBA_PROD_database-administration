    {
      "parameters": {
        "jsCode": "const html = $input.first().json.data || '';\nconst rows = html.match(/<tr>[\\s\\S]*?<\\/tr>/g);\n\n// Nếu không có hàng nào thì trả về output để node IF tiếp theo vẫn chạy được\nif (!rows || rows.length === 0) {\n  return [{\n    json: {\n      hasData: false\n    }\n  }];\n}\n\nconst results = [];\n\n// Danh sách assignee được phép\nconst allowedAssignees = [\n  \"kean.nguyen\",\n  \"malcolm.huynh\",\n  \"lukas.luu\",\n  \"roy.du\",\n  \"dominic.dao\",\n  \"daniel.truong\",\n  \"patrick.pham\",\n  \"sol.le\",\n  \"evan.trinh\",\n  \"brice.nguyen\"\n];\n\nfor (const row of rows) {\n  const tds = row.match(/<td[\\s\\S]*?<\\/td>/g);\n  if (!tds || tds.length < 12) continue;\n\n  // Extract requester\n  const requester = tds[7].replace(/<[^>]*>/g, '').trim();\n\n  // Extract environment\n  const envFull = tds[8].replace(/<[^>]*>/g, '').trim();\n  const envUpper = envFull.toUpperCase();\n  if (envUpper.includes('LOCAL')) {\n    continue;\n  }\n\n  // Extract assignee\n  const assignee = tds[9].replace(/<[^>]*>/g, '').trim() || null;\n  if (!assignee || !allowedAssignees.includes(assignee.toLowerCase())) {\n    continue;\n  }\n\n  // Extract Deploy In UM & Deploy Time\n  const umSpans = tds[11].match(/<span class=\"um\">([^<]*)<\\/span>/g);\n  let deployInUM = \"No\";\n  let deployTime = null;\n\n  if (umSpans && umSpans.length > 0) {\n    const umTexts = umSpans.map(s => s.replace(/<[^>]*>/g, '').trim()).filter(Boolean);\n    if (umTexts.includes(\"UM\")) {\n      deployInUM = \"Yes\";\n      const timeStr = umTexts.find(t => t !== \"UM\");\n      if (timeStr) deployTime = timeStr;\n    } else {\n      deployTime = umTexts[0];\n    }\n  }\n\n  // Extract package name\n  const pkgMatch = row.match(/<a[^>]*class=\"[^\"]*view-package[^\"]*\"[^>]*>(.*?)<\\/a>/);\n  const packageName = pkgMatch ? pkgMatch[1].trim() : null;\n\n  // Extract repo name\n  const repoMatch = row.match(/data-sitename=\"([^\"]+)\"/);\n  const repo = repoMatch ? repoMatch[1].trim() : null;\n\n  // Determine package type\n  const packageTypeMatch = row.match(/badge-label package-type\\s+([^\"]+)\"/);\n  let packageType = '[SP/Func]';\n  if (packageTypeMatch) {\n    const typeClass = packageTypeMatch[1].toLowerCase();\n    if (typeClass.includes('sp-func')) {\n      packageType = '[SP/Func]';\n    } else if (typeClass.includes('script')) {\n      packageType = '[Script]';\n    }\n  }\n\n  // Extract request time\n  const timeMatch = row.match(/<span class=\"request-time\"[^>]*data-time=\"([^\"]+)\"/);\n  const requestTime = timeMatch ? timeMatch[1].trim() : null;\n\n  if (!deployTime && requestTime) {\n    deployTime = requestTime;\n  }\n\n  results.push({\n    type: packageType,\n    requester,\n    repo: `${packageType === '[Script]' ? 'Scripts ' : ''}${repo}`,\n    packageName,\n    environment: envFull,\n    assignee,\n    deployInUM,\n    requestTime,\n    deployTime\n  });\n}\n\n// Nếu sau cùng không có kết quả nào thỏa điều kiện, vẫn cần trả về hasData: false\nif (results.length === 0) {\n  return [{\n    json: {\n      hasData: false\n    }\n  }];\n}\n\n// Nếu có kết quả, gắn hasData: true vào từng item\nreturn results.map(item => ({\n  json: {\n    hasData: true,\n    message: `${item.type} Deployment request has been created by ${item.requester} :rocket:\nRepo: ${item.repo}\nPackage: ${item.packageName}\nEnvironment: ${item.environment}\nAssignee: ${item.assignee || 'Unassigned'}\nDeploy In UM: ${item.deployInUM}\nRequest Time: ${item.requestTime || 'N/A'}\nDeploy Time: ${item.deployTime || 'N/A'}`,\n    ...item\n  }\n}));\n"
      },
