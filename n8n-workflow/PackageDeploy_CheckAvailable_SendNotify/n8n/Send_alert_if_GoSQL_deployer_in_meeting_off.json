    {
      "parameters": {
        "jsCode": "const loginName = 'evan.trinh';\nconst siteName = 'Rocketor';\n// Lấy thời gian hiện tại (UTC+7)\nconst now = new Date();\nconst offsetMs = 7 * 60 * 60 * 1000; // +07:00\nconst vietnamTime = new Date(now.getTime() + offsetMs);\n\n// Format thành \"YYYY-MM-DD HH:mm:ss\"\nfunction formatDateTime(date) {\n  return date.toISOString().replace('T', ' ').substring(0, 19);\n}\n\n// Trả về dữ liệu mới\nreturn $input.all().map(item => {\n  return {\n    json: {\n      ...item.json,\n      LoginName: loginName,\n      SiteName: siteName,\n      startTime: formatDateTime(vietnamTime)\n    }\n  };\n});\n"
