#network
MYSQL_NETWORK=customerloguat_network
EXTERNAL_NETWORK=true
DRIVER_NETWORK=bridge

#config
MYSQL_LOG=/volumes/customerloguat/log
MYSQL_CONF=/volumes/customerloguat/conf.d
MYSQL_DIR=/volumes/customerloguat
MYSQL_INIT=/volumes/customerloguat/init.d

#container
MYSQL_TAG=8.0.20
MYSQL_HOST=customerloguat
MYSQL_PORT=3326
MYSQL_LOG_CONSOLE=false
MYSQL_ENV=PRO

#volume
DATA_VOLUME=customerloguat_data
EXTERNAL_VOLUME=true