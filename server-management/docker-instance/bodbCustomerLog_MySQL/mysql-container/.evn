#network
MYSQL_NETWORK=customerloguat_network
EXTERNAL_NETWORK=true
DRIVER_NETWORK=bridge

#config
MYSQL_DATA=/volumes/customerloguat/data
MYSQL_LOG=/var/docker/customerloguat/log
MYSQL_INIT=/var/docker/customerloguat/init.d
MYSQL_CONF=/var/docker/customerloguat/conf.d
MYSQL_DIR=/var/docker/customerloguat

#container
MYSQL_TAG=8.0.20
MYSQL_HOST=customerloguat
MYSQL_PORT=3316
MYSQL_LOG_CONSOLE=false
MYSQL_ENV=PRO

