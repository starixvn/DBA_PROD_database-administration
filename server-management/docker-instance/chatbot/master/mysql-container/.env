#network
MYSQL_NETWORK=chatbot_network
EXTERNAL_NETWORK=true
DRIVER_NETWORK=bridge

#config
MYSQL_DATA=/volumes/chatbot_master/data
MYSQL_LOG=/var/docker/chatbot_master/log
MYSQL_INIT=/var/docker/chatbot_master/init.d
MYSQL_CONF=/var/docker/chatbot_master/conf.d
MYSQL_DIR=/var/docker/chatbot_master

#container
MYSQL_TAG=8.0.20
MYSQL_HOST=chatbot_master
MYSQL_PORT=3316
MYSQL_LOG_CONSOLE=false
MYSQL_ENV=PRO

