#network
MYSQL_NETWORK=chatbot_network
EXTERNAL_NETWORK=true
DRIVER_NETWORK=bridge

#config
MYSQL_DATA=/volumes/chatbot_slave/data
MYSQL_LOG=/var/docker/chatbot_slave/log
MYSQL_INIT=/var/docker/chatbot_slave/init.d
MYSQL_CONF=/var/docker/chatbot_slave/conf.d
MYSQL_DIR=/var/docker/chatbot_slave

#container
MYSQL_TAG=8.0.20
MYSQL_HOST=chatbot_slave
MYSQL_PORT=3316
MYSQL_LOG_CONSOLE=false
MYSQL_ENV=PRO
