#network
MYSQL_NETWORK=chatbox_dev_network
EXTERNAL_NETWORK=true
DRIVER_NETWORK=overlay

#config
MYSQL_DATA=/volumes/chatbox-master-dev/data
MYSQL_LOG=/var/docker/chatbox-master-dev/log
MYSQL_INIT=/var/docker/chatbox-master-dev/init.d
MYSQL_CONF=/var/docker/chatbox-master-dev/conf.d
MYSQL_DIR=/var/docker/chatbox-master-dev

#container
MYSQL_TAG=8.0.20
MYSQL_HOST=dev_chatbox_master
MYSQL_PORT=3319
MYSQL_LOG_CONSOLE=false
MYSQL_ENV=DEV
