# Network
MONGO_NETWORK=mongodb-rocketchat-network
DRIVER_NETWORK=bridge
EXTERNAL_NETWORK=true

# Config
MONGO_BACKUP=/mount/volumes/rocketchat33/backup
MONGO_DATA=/mount/volumes/rocketchat33/data
MONGO_LOG=/var/docker/rocketchat33/log
MONGO_CONF=/var/docker/rocketchat33/config
MONGO_CONFIG_DIR=/var/docker/rocketchat33/yaml_config_files
TIMEZONE=Etc/GMT-4

# MONGODB
MONGO_TAG=7.0.18
MONGO_HOST=rocketchat_33
MONGO_PORT=16602
MONGO_INITDB_ROOT_USERNAME=admin
MONGO_INITDB_ROOT_PASSWORD=admin
