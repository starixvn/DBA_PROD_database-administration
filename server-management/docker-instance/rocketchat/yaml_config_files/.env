# Network
MONGO_NETWORK=owp-rocketchat-network
DRIVER_NETWORK=bridge
EXTERNAL_NETWORK=true

# Config
MONGO_BACKUP=/volumes/rocketchat/data/backup
MONGO_DATA=/volumes/rocketchat/data
MONGO_LOG=/var/docker/rocketchat/log
MONGO_CONF=/var/docker/rocketchat/config
MONGO_CONFIG_DIR=/var/docker/rocketchat/yaml_config_files/
TIMEZONE=Etc/GMT-4

# MONGODB
MONGO_TAG=7.0.18
MONGO_HOST=owp_rocketchat
MONGO_PORT=16601
MONGO_INITDB_ROOT_USERNAME=admin
MONGO_INITDB_ROOT_PASSWORD=admln123


