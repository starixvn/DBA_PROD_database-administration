#network
MYSQL_NETWORK=app_network
EXTERNAL_NETWORK=false
DRIVER_NETWORK=bridge

#mysql container
MYSQL_TAG=8.0.20
MYSQL_HOST=test_mysql_8020
MYSQL_PORT=3399
MYSQL_DATA=/volumes/test_mysql/data
MYSQL_CONF=/volumes/test_mysql/conf.d
MYSQL_LOG=/volumes/test_mysql/log

#volume
DATA_VOLUME=test_mysql_data
EXTERNAL_VOLUME=false

