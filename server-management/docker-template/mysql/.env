#network
MYSQL_NETWORK=<app_network_name?>
EXTERNAL_NETWORK=<true|false?>
DRIVER_NETWORK=<bridge|host|overlay>

#mysql container
MYSQL_TAG=<mysql_version?>
MYSQL_HOST=<mysql_host_name?>
MYSQL_PORT=<public_port?>
MYSQL_CONF=<path_to_conf_file?>
MYSQL_LOG=<path_to_log_file?>
MYSQL_INIT=<path_to_initdb?>

#volume
DATA_VOLUME=<app_volume_name?>
EXTERNAL_VOLUME=<true|false?>
