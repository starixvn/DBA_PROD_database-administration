#network
MYSQL_NETWORK=app_network
EXTERNAL_NETWORK=false
DRIVER_NETWORK=bridge

#mysql container
MYSQL_TAG=8.0.20
MYSQL_HOST=mysql_8020
MYSQL_PORT=3320
#MYSQL_DATA=../volume/data
MYSQL_CONF=../volume/conf.d
MYSQL_LOG=../volume/logs
MYSQL_INIT=./init.d

#volume
#docker volume create --driver local --opt type=none --opt device=/<path-to-store?>/data --opt o=bind app_volume_name
DATA_VOLUME=app_volume_name
EXTERNAL_VOLUME=false
